{
  "mcpServers": {
    "github": {
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/mcp-github.sh"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@microsoft/mcp-server-playwright"]
    },
    "supabasePostgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "${env:DATABASE_URL}"
      ],
      "envFile": "${workspaceFolder}/.env.local"
    }
  }
}
